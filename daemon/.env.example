PCL_ANTHROPIC_API_KEY=
PCL_ANTHROPIC_MODEL=
PCL_VOYAGE_API_KEY=
PCL_VOYAGE_MODEL=
PCL_HOST=0.0.0.0
PCL_PORT=8787
PCL_DATA_ROOT=~/.pcl
PCL_LOCAL_CAPTION=false
PCL_LOCAL_EMBED=false

# Cosine-distance ceiling for a semantic hit, in [0, 2]. Lower is stricter.
# Calibrate against real captures; see T-007.
PCL_SEMANTIC_DISTANCE_THRESHOLD=0.6

# Set these after calibrating with real CoreS3-Lite captures.
# PCL_SHARPNESS_THRESHOLD=100.0
# PCL_BRIGHTNESS_THRESHOLD=30.0
